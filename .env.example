# Docker y las plataformas cloud inyectan estas variables directamente.
# Local: copiar a .env y ejecutar npm run start:env (Node.js 24).
NODE_ENV=production
PORT=3000
# Orígenes exactos separados por comas; sin rutas ni barra final.
# Vacío: producción permite el mismo origen y los dos dominios Firebase de FLEET.IO.
CLIENT_ORIGINS=
# CLIENT_ORIGINS=https://fleet.vercel.app,https://fleet.pages.dev
# Use a persistent Render disk for economy data. Never commit the real secret.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ECONOMY_SECRET=
# Example on a mounted disk: /var/data/fleet/economy.json
ECONOMY_FILE=
